{
  "name": "beaver-desktop",
  "productName": "圆梦同行",
  "version": "2.2.60",
  "description": "圆梦同行桌面客户端（Electron 在线壳，加载 https://8811.info/app/）",
  "main": "src/main.js",
  "author": "Beaver IM Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "xvfb-run -a electron . --smoke --no-sandbox",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.beaver.desktop",
    "productName": "圆梦同行",
    "copyright": "Copyright © 2024-2026 Beaver IM Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;InstantMessaging",
      "icon": "build/icon.png",
      "synopsis": "圆梦同行 IM 桌面客户端"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "圆梦同行"
    }
  }
}